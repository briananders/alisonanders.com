# Only surface moderate+ vulnerabilities during install.
# The remaining low-severity findings are all in elliptic (GHSA-848j-6mx2-7j84 /
# CVE-2025-14505): an ECDSA faulty-signature bug that can expose secret keys.
# elliptic@6.6.1 is the latest published version — no patch exists in the registry
# (first_patched_version: null). Risk is zero for this project:
#   - elliptic enters node_modules via browserify -> crypto-browserify -> browserify-sign
#   - none of the source files require('crypto') or use ECDSA/ECDH operations
#   - the built JS bundles contain no elliptic code (verified by grep on package/)
audit-level=moderate
# eslint-config-airbnb-base declares peer deps on eslint ^7||^8 but works fine with v9
# via FlatCompat. Suppress peer dep errors so npm install succeeds.
legacy-peer-deps=true
