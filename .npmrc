# Only surface moderate+ vulnerabilities during install.
# The 4 remaining low-severity findings are all in elliptic (GHSA-848j-6mx2-7j84),
# a Browserify crypto polyfill. elliptic@6.6.1 is the latest published version —
# no patch exists in the registry. Risk is negligible: these polyfills are bundled
# into static browser assets only and perform no cryptographic operations at runtime.
audit-level=moderate
# eslint-config-airbnb-base declares peer deps on eslint ^7||^8 but works fine with v9
# via FlatCompat. Suppress peer dep errors so npm install succeeds.
legacy-peer-deps=true
